NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. The kit's sign-in (invites, roles, leavers, recovery, audit), the
# auth clean-up cron, /api/setup and /api/errors use it. Required for every
# build except Vercel previews (src/lib/env.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SETUP_SECRET=your-setup-secret

# Staff sign-in (@anchor-nights/kit/auth). Required for every build except
# Vercel previews, where sign-in then fails closed with "sign-in is unavailable".
# The app origin, used in invite and password reset links. A bare https origin.
NEXT_PUBLIC_APP_URL=https://bingo-blast-ten.vercel.app
# Cloudflare Turnstile, on sign-in, forgot password and invite acceptance. The
# same secret goes in Supabase, Authentication, Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hashes emails and IP addresses in the sign-in audit. A version, a colon, then
# at least 32 random characters: v1: followed by `openssl rand -base64 48`.
# Server only.
AUDIT_HMAC_KEY=

# Vercel sends this as a bearer token to the daily /api/cron/auth-maintenance
# run (vercel.json). Without it the route refuses everything (503). Any random
# value of at least 32 characters, e.g. `openssl rand -hex 32`. Server only.
CRON_SECRET=

# The app's public address: the origin every QR code uses. Required on a Vercel
# production build, which fails without it (src/lib/env.ts):
# https://bingo.the-anchor.pub once that domain is live, and
# https://bingo-blast-ten.vercel.app until then. Optional on previews (ignored
# there) and local runs. When set it must be a bare https origin, with no path;
# plain http is accepted only for localhost outside production.
NEXT_PUBLIC_SITE_URL=

# Optional. The other nights' addresses for the front page's "Other nights"
# row, as bare https origins (the build fails on any other shape). A night
# shows only when its address is set and the events feed has an upcoming event
# of that night; leave one empty to leave it out.
NEXT_PUBLIC_QUIZ_NIGHT_URL=
NEXT_PUBLIC_MUSIC_BINGO_URL=
NEXT_PUBLIC_TASTING_NIGHT_URL=

# Optional. Where technical failures are posted so they outlive Vercel's log
# retention: this app's own /api/errors route on the production address, e.g.
# https://bingo-blast-ten.vercel.app/api/errors. It stores them in the
# app_errors table and /admin/errors lists them. Leave unset and error
# reporting is a no-op beyond the existing console logging.
#
# Only the error message and code are ever sent, with uuids, email addresses,
# phone numbers and money amounts masked (again on arrival), and Postgres
# DETAIL and HINT dropped entirely, because DETAIL contains the failing row.
ERROR_SINK_URL=
# Required once ERROR_SINK_URL is set (the build fails without it): a random
# value of at least 32 characters, e.g. `openssl rand -hex 32`. The sender
# sends it as a bearer token and the route refuses any post without it.
# On Vercel production SUPABASE_SERVICE_ROLE_KEY is then required too, because
# only the service role can write app_errors. All server only.
ERROR_SINK_TOKEN=

# Optional. logError() is silent in production unless this is "true". Set it
# when you need the browser and server consoles to show technical failures.
LOG_ERRORS=

# The management API key with the read:events scope, for the upcoming events
# carousel. Server only: never prefix it with NEXT_PUBLIC_. Required for Vercel
# production builds, which fail without it (src/lib/env.ts); optional
# everywhere else, where the screens show the feed as not configured. A value of
# only spaces counts as not set, and a value that is set must be the key itself
# ("anch_" followed by the key, no spaces) or the build fails.
ANCHOR_API_KEY=
# Optional. Defaults to https://management.orangejelly.co.uk/api. Server only.
# When set it must use https, because the key is sent to it; plain http is
# accepted only for localhost outside production. The build fails otherwise.
ANCHOR_API_BASE_URL=

# NEXT_PUBLIC_BUILD_ID is NOT set here: next.config.ts sets it at build time from
# VERCEL_GIT_COMMIT_SHA ("dev" locally) so long-lived screens can spot a new
# release.
