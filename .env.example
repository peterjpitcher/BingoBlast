NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SETUP_SECRET=your-setup-secret

# Used as a fallback for production join URLs when request headers are unavailable.
# Set to the public origin, e.g. https://bingo.theanchor.pub
# When set it must be a bare https origin, with no path; the build fails
# otherwise (src/lib/env.ts). Plain http is accepted only for localhost outside
# production.
NEXT_PUBLIC_SITE_URL=

# Optional. Where technical failures are posted so they outlive Vercel's log
# retention: this app's own /api/errors route on the production address, e.g.
# https://bingo-blast-ten.vercel.app/api/errors. It stores them in the
# app_errors table and /admin/errors lists them. Leave unset and error
# reporting is a no-op beyond the existing console logging.
#
# Only the error message and code are ever sent, with uuids, email addresses,
# phone numbers and money amounts masked (again on arrival), and Postgres
# DETAIL and HINT dropped entirely, because DETAIL contains the failing row.
ERROR_SINK_URL=
# Required once ERROR_SINK_URL is set (the build fails without it): a random
# value of at least 32 characters, e.g. `openssl rand -hex 32`. The sender
# sends it as a bearer token and the route refuses any post without it.
# On Vercel production SUPABASE_SERVICE_ROLE_KEY is then required too, because
# only the service role can write app_errors. All server only.
ERROR_SINK_TOKEN=

# Optional. logError() is silent in production unless this is "true". Set it
# when you need the browser and server consoles to show technical failures.
LOG_ERRORS=

# The management API key with the read:events scope, for the upcoming events
# carousel. Server only: never prefix it with NEXT_PUBLIC_. Required for Vercel
# production builds, which fail without it (src/lib/env.ts); optional
# everywhere else, where the screens show the feed as not configured. A value of
# only spaces counts as not set, and a value that is set must be the key itself
# ("anch_" followed by the key, no spaces) or the build fails.
ANCHOR_API_KEY=
# Optional. Defaults to https://management.orangejelly.co.uk/api. Server only.
# When set it must use https, because the key is sent to it; plain http is
# accepted only for localhost outside production. The build fails otherwise.
ANCHOR_API_BASE_URL=

# NEXT_PUBLIC_BUILD_ID is NOT set here: next.config.ts sets it at build time from
# VERCEL_GIT_COMMIT_SHA ("dev" locally) so long-lived screens can spot a new
# release.
